# syntax=docker/dockerfile:1.7
# ongrid cloud service image — multi-stage, distroless final.
# Build context MUST be the repo root (see Makefile target `docker-ongrid`).

ARG VERSION=dev

# ---------- Stage 1: builder ----------
# We need CGO for the fastembed-go local embedder (yalue/onnxruntime_go
# is a thin cgo wrapper over libonnxruntime). Switched base from
# golang:1.25-alpine to bookworm so the build host has gcc + glibc to
# satisfy the cgo link step + the runtime image (also debian) so the
# onnxruntime .so finds its dependencies (libstdc++, libgomp).
FROM golang:1.25-bookworm AS builder

ARG VERSION
ARG TARGETARCH

# Module proxy. The Go toolchain default (proxy.golang.org) is
# unreachable from CN networks, and GOPROXY is NOT a fail-fast list:
# Go tries the entries in order and does NOT fall through to the next
# one on a dial timeout — it hard-fails after ~60s per module. Without
# a reachable mirror first, the `go mod download` step below reads as
# hung. Keep a reachable mirror FIRST; override per build with
# `--build-arg GOPROXY=<mirror>` (deploy/docker-compose.yml forwards
# $GOPROXY, Makefile targets can pass it directly).
ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /app

RUN set -eux; \
    echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends \
            build-essential pkg-config && break; \
        [ "$i" = 5 ] && exit 1; echo "apt attempt $i failed, retrying in 5s"; sleep 5; \
    done; \
    rm -rf /var/lib/apt/lists/*

# Cache go.mod / go.sum layer separately from source. The
# `--mount=type=cache,target=/go/pkg/mod` keeps the module download
# cache across image rebuilds — without it every package run repays
# the ~150s mod-download cost. Requires syntax=docker/dockerfile:1.7
# (declared at the top of this file).
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy the rest of the repo (build context = repo root).
COPY . .

# CGO_ENABLED=1 because of the local embedder (see top of stage 1).
# Two cache mounts:
#   /go/pkg/mod    — module download cache (same as above)
#   /root/.cache/go-build — Go's per-package compile cache; the big
#                          win — a no-op rebuild drops from ~2min to
#                          ~5s when the cache hits.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/ongrid ./cmd/ongrid

# ---------- Stage 2: runtime ----------
# debian:bookworm-slim so the cgo binary's glibc + libstdc++ + libgomp
# deps resolve at runtime (alpine's musl would need a separate
# onnxruntime musl build that doesn't ship from upstream). git is still
# needed for knowledge-base repo sync, openssh-client for SSH-style
# repo URLs.
FROM debian:bookworm-slim

# Knowledge-base + onnxruntime runtime deps.
#   - git / openssh-client / ca-certificates / tzdata: same role as
#     before the bookworm switch.
#   - libgomp1: openmp runtime libonnxruntime needs.
#   - libstdc++6 / libc6: already present in bookworm-slim but kept
#     explicit so a future minify pass doesn't surprise us.
#   - curl: needed by the in-image entry-shim if we ever inline the
#     model download; lightweight, keep it.
#   - python3 / python3-pip: the cloud_bash sandbox runs as non-root with
#     no package manager, so an agent can't install tooling at runtime; a
#     huge swath of cloud CLIs (tccli, awscli, …) are Python. Ship a usable
#     Python interpreter so cloud_bash can install + run them. The TOOLS
#     themselves are NOT baked here — they install into a host-mounted
#     persistent volume (/var/lib/ongrid/tools, the cloud_bash PYTHONUSERBASE)
#     so they survive container recreation, don't bloat the image, and can be
#     added at runtime via the approval-gated cloud_bash (no image rebuild).
# Retry up to 5× — deb.debian.org intermittently 502s, and a single transient
# failure here otherwise kills the whole image build. Acquire::Retries also
# retries individual package downloads within one apt run.
RUN set -eux; \
    echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends \
            git openssh-client ca-certificates tzdata libgomp1 libstdc++6 curl \
            python3 python3-pip && break; \
        [ "$i" = 5 ] && exit 1; echo "apt attempt $i failed, retrying in 5s"; sleep 5; \
    done; \
    rm -rf /var/lib/apt/lists/*

# ONNX Runtime shared library. Pin the version so a future apt-mirror
# bump doesn't silently change ABI. v1.20.1 is the latest stable that
# fastembed-go's yalue/onnxruntime_go@v1.7.0 was tested against.
#
# Sources, tried in order:
#   1. $ONNXRUNTIME_TARBALL_URL — explicit override for build hosts that
#      mirror the tarball or run air-gapped.
#   2. The GitHub release asset (canonical source). Its connect timeout is
#      short so a firewalled github.com fails fast instead of looking hung.
#   3. The PyPI `onnxruntime` wheel — the same Microsoft-published binary
#      and 13 MB instead of 108 MB. PyPI stays reachable where github.com
#      and nuget.org are slow or blocked from the build network.
#   4. The nuget.org Microsoft.ML.OnnxRuntime package — a 108 MB all-RID
#      nupkg that CN networks throttle to a crawl; last resort only.
# The resolved .so is kept in a BuildKit cache mount: image-layer caching
# does not survive a builder prune, and without this every prune pays for
# the download again. Arch is part of the cache path because multi-arch
# builders share one cache directory.
ARG ONNXRUNTIME_VERSION=1.20.1
ARG ONNXRUNTIME_TARBALL_URL=
ARG TARGETARCH
RUN --mount=type=cache,target=/root/.cache/onnxruntime \
    set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${arch}" in \
        amd64|x86_64) ORT_ARCH=x64; NUGET_RID=linux-x64; PYPI_ARCH=x86_64 ;; \
        arm64|aarch64) ORT_ARCH=aarch64; NUGET_RID=linux-arm64; PYPI_ARCH=aarch64 ;; \
        *) echo "unsupported arch ${arch}" >&2; exit 1 ;; \
    esac; \
    cache="/root/.cache/onnxruntime/${ORT_ARCH}"; \
    so="${cache}/libonnxruntime.so.${ONNXRUNTIME_VERSION}"; \
    mkdir -p "${cache}"; \
    if [ ! -s "${so}" ]; then \
        url="${ONNXRUNTIME_TARBALL_URL:-https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}.tgz}"; \
        if curl -fL --connect-timeout 5 --retry 2 -o "${cache}/ort.tgz.part" "${url}"; then \
            tar -xzf "${cache}/ort.tgz.part" -C "${cache}"; \
            install -m 0755 "${cache}/onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}/lib/libonnxruntime.so.${ONNXRUNTIME_VERSION}" "${so}.part"; \
        elif wheel="$(python3 -c 'import json, sys, urllib.request; \
data = json.load(urllib.request.urlopen("https://pypi.org/pypi/onnxruntime/%s/json" % sys.argv[1], timeout=30)); \
print(next(f["url"] for f in data["urls"] if f["filename"].endswith(".whl") and "manylinux" in f["filename"] and sys.argv[2] in f["filename"]))' \
                "${ONNXRUNTIME_VERSION}" "${PYPI_ARCH}")" \
            && curl -fL --connect-timeout 10 --retry 2 -o "${cache}/ort.whl.part" "${wheel}"; then \
            python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extract(sys.argv[2], sys.argv[3])' \
                "${cache}/ort.whl.part" "onnxruntime/capi/libonnxruntime.so.${ONNXRUNTIME_VERSION}" "${cache}/wheel"; \
            install -m 0755 "${cache}/wheel/onnxruntime/capi/libonnxruntime.so.${ONNXRUNTIME_VERSION}" "${so}.part"; \
        else \
            echo "tarball and PyPI wheel failed, falling back to nuget.org" >&2; \
            curl -fL --connect-timeout 10 --retry 3 -o "${cache}/ort.nupkg.part" \
                "https://www.nuget.org/api/v2/package/Microsoft.ML.OnnxRuntime/${ONNXRUNTIME_VERSION}"; \
            python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extract(sys.argv[2], sys.argv[3])' \
                "${cache}/ort.nupkg.part" "runtimes/${NUGET_RID}/native/libonnxruntime.so" "${cache}/nupkg"; \
            install -m 0755 "${cache}/nupkg/runtimes/${NUGET_RID}/native/libonnxruntime.so" "${so}.part"; \
        fi; \
        mv "${so}.part" "${so}"; \
        rm -rf "${cache}/ort.tgz.part" "${cache}/ort.whl.part" "${cache}/ort.nupkg.part" \
            "${cache}/wheel" "${cache}/nupkg" "${cache}/onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}"; \
    fi; \
    install -m 0755 "${so}" /usr/lib/libonnxruntime.so.${ONNXRUNTIME_VERSION}; \
    ln -sf /usr/lib/libonnxruntime.so.${ONNXRUNTIME_VERSION} /usr/lib/libonnxruntime.so; \
    ldconfig
ENV ONNX_PATH=/usr/lib/libonnxruntime.so

COPY --from=builder /out/ongrid /ongrid

# Ship the agent personas read by chatruntime.LoadAll from `./agents`.
# Skill packs are installed separately at /var/lib/ongrid/skills.
COPY --from=builder /app/agents /agents

# ADR-024 edge upgrade bundles are bind-mounted from the host at
# runtime (see deploy/docker-compose.yml). install.sh / upgrade.sh
# stage `dist/.../edge-bundles/*.tar.gz` into /opt/ongrid/edge-bundles
# on the host, which we mount into this container read-only at
# /usr/share/ongrid/edge-bundles so the manager can read each bundle's
# .sha256 companion when resolving an upgrade. Bundle bytes themselves
# are served by nginx out of the existing /edge/ static location;
# manager-side download is never on the hot path.
RUN mkdir -p /usr/share/ongrid/edge-bundles

# Knowledge-base git clones land here. Bind-mount this in production
# to keep them across container restarts.
RUN mkdir -p /var/lib/ongrid/repos
WORKDIR /

# 8080 = HTTP API, 9100 = Prometheus /metrics (see ADR-004 §2).
EXPOSE 8080 9100

# Non-root user. debian:bookworm-slim has groupadd/useradd; pin to the
# same uid (65532) the old alpine layer used so file-perm semantics on
# bind-mounted /var/lib/ongrid survive the base switch.
RUN groupadd --system --gid 65532 nonroot && \
    useradd  --system --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin nonroot && \
    chown -R nonroot:nonroot /var/lib/ongrid
# HOME defaults to / for useradd --no-create-home; fastembed-go's
# sugarme/tokenizer dep does $HOME/.cache/tokenizer mkdir and crashes
# on / (not writable as nonroot). Point HOME at the manager state dir
# so the tokenizer dir lands somewhere writable.
ENV HOME=/var/lib/ongrid
USER nonroot
ENTRYPOINT ["/ongrid"]
